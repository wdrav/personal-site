---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Trail-difficulty markers, purely decorative.
type Icon = "green" | "blue" | "black" | "double";
type Bullet = string | { text: string; sub: string[] };
type Entry = {
  title: string;
  when?: string;
  role?: string;
  place?: string;
  bullets?: Bullet[];
  lines?: [string, string][];
};
type Stop = { icon: Icon; label: string; entries: Entry[] };

// Content taken from the resume (contact details left out).
const stops: Stop[] = [
  {
    icon: "green",
    label: "Education",
    entries: [
      {
        title: "University of Colorado Boulder",
        when: "May 2025",
        role: "B.S. in Computer Science, Minor in Data Science",
        place: "College of Engineering and Applied Science · Boulder, CO",
        bullets: [
          "GPA: 3.99/4.00 | Summa Cum Laude | Dean’s List (all semesters)",
          "Activities: Alpha Kappa Psi (business fraternity), Kappa Theta Pi (co-founder), CU Swim & Dive, CU Poker Club",
        ],
      },
    ],
  },
  {
    icon: "black",
    label: "Experience",
    entries: [
      {
        title: "KPMG",
        when: "August 2025 – Present",
        role: "Deal Advisory & Strategy Analytics Associate",
        place: "New York, NY",
        bullets: [
          "Work directly with private equity sponsors and C-suite executives of TMT companies on buy-side and sell-side diligence, building the revenue, retention, and ARR analyses that test and support the investment thesis",
          "Turn transaction- and bookings-level data into client-ready KPIs and a clear narrative of top-line growth and customer health over time, using Alteryx, Databricks, and SQL",
          {
            text: "Project Magenta – CARR and retention modeling for a $1.2B+ ARR software portfolio company",
            sub: [
              "Built contracted ARR (CARR) and retention models, using in-depth company research to write more accurate customer- and product-level logic",
              "Led implementation on client systems, working with the client’s team to debug the SQL processing logic",
            ],
          },
          {
            text: "Project Radiant – Sell-side diligence for a $100M+ ARR portfolio company",
            sub: [
              "Owned the ARR and revenue modeling workstream; led discussions with management and the PE sponsor to produce the most accurate, defensible view of the business",
              "Partnered with the Quality of Earnings team on reconciliations and data-driven evidence supporting the models",
            ],
          },
        ],
      },
    ],
  },
  {
    icon: "double",
    label: "Experience",
    entries: [
      {
        title: "Measures AI",
        when: "August 2024 – May 2025",
        role: "Co-Founder & Natural Language Processing Engineer",
        place: "Boulder, CO",
        bullets: [
          "Co-founded a startup that analyzed sales conversations and emails to surface the drivers of sales success for client firms",
          "Raised $100K+ in outside funding; placed 2nd of 104 teams in the New Venture Challenge ($10K prize)",
          "Built the semantic-analysis engine (Python, Pandas, Hugging Face) and a React front end for client use",
        ],
      },
    ],
  },
  {
    icon: "blue",
    label: "Experience",
    entries: [
      {
        title: "Comcast",
        when: "May 2024 – August 2024",
        role: "Network Engineering Intern",
        place: "Littleton, CO",
        bullets: [
          "Automated cable modem and Remote PHY device testing in Python and Bash, saving engineers 300+ hours a year",
          "Built a full-stack tool (Flask, JavaScript, SQLite) turning the test scripts into a self-serve GUI for engineers",
        ],
      },
    ],
  },
  {
    icon: "blue",
    label: "Experience",
    entries: [
      {
        title: "University of Colorado Genetic Logic Lab",
        when: "May 2022 – May 2024",
        role: "Software Development Intern",
        place: "Boulder, CO",
        bullets: [
          "Built Python pipelines converting raw lab data into the SBOL standard, expanding data access for synthetic biology researchers at labs worldwide",
        ],
      },
    ],
  },
  {
    icon: "blue",
    label: "Leadership",
    entries: [
      {
        title: "Kappa Theta Pi",
        when: "April 2023 – May 2025",
        role: "Co-Founder, VP of Professional Development",
        place: "Boulder, CO",
        bullets: [
          "Co-founded CU Boulder’s professional tech fraternity; led programs giving members employable tech experience",
        ],
      },
      {
        title: "Alpha Kappa Psi",
        when: "January 2023 – May 2023",
        role: "IT Director",
        place: "Boulder, CO",
        bullets: [
          "Led IT for the 110-member business fraternity; automated member data tracking in Google Apps Script and Sheets",
        ],
      },
    ],
  },
  {
    icon: "green",
    label: "Skills & Interests",
    entries: [
      {
        title: "Skills & Interests",
        lines: [
          ["Analytics", "ARR/CARR and retention analysis, revenue modeling, buy- and sell-side diligence, data visualization, NLP"],
          ["Tools", "Excel, PowerPoint, Alteryx, Databricks, SQL, Python, Git, Jira; also C++, Java, JavaScript, Bash"],
          ["Interests", "Skiing, Powerlifting, Swimming, Water Polo, Reading, Traveling"],
        ],
      },
    ],
  },
];

const iconLabel: Record<Icon, string> = {
  green: "Green circle",
  blue: "Blue square",
  black: "Black diamond",
  double: "Double black diamond",
};
---

<Layout title="Experience — Will">
  <nav>
    <div class="container">
      <a href={base} class="logo">will.</a>
      <ul class="nav-links">
        <li><a href={`${base}#about`}>About</a></li>
        <li><a href={`${base}experience/`} aria-current="page">Experience</a></li>
      </ul>
    </div>
  </nav>

  <main class="run" data-run>
    <!-- Line-art trail, markers and trees. Drawn by the script below to fit the
         cards; without JavaScript the cards still show on their own. -->
    <svg class="trail-art" data-trail-art aria-hidden="true">
      <defs>
        <symbol id="tree" viewBox="0 0 20 30">
          <!-- Colors are set here, not in CSS: page styles don't reach inside <use> copies. -->
          <path
            d="M10 1 L15 9 H12.5 L17.5 17 H14 L19 25 H1 L6 17 H2.5 L7.5 9 H5 Z M10 25 V29"
            fill="none"
            stroke="#8888a0"
            stroke-opacity="0.6"
            stroke-width="1.1"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
          <path d="M10 1 L13.1 6 L11.4 5.2 L10 6.6 L8.6 5.2 L6.9 6 Z" fill="#e8e8ec" fill-opacity="0.85" />
        </symbol>
      </defs>
      <g data-trees></g>
      <path class="trail-route" data-route></path>
      <path class="trail-tracks" data-tracks pathLength="1"></path>
      <g data-markers></g>
      <circle class="trail-skier" data-skier r="5"></circle>
    </svg>

    <section class="run-intro">
      <div class="container">
        <svg class="ridge" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="ridge-line"
            d="M0 112 L52 78 L84 92 L150 30 L196 70 L228 56 L300 8 L352 60 L384 46 L448 84 L492 50 L548 88 L600 70"
          />
          <path class="ridge-snow" d="M136 43 L150 30 L165 44 M287 21 L300 8 L314 23 M480 59 L492 50 L503 60" />
        </svg>
        <div class="intro">
          <p class="stop-meta">Top of the run</p>
          <h1>Experience</h1>
          <a class="text-link" href={`${base}resume.pdf`} target="_blank" rel="noopener">Download the PDF</a>
        </div>
      </div>
    </section>

    {
      stops.map((stop, i) => (
        <section class="run-stop">
          <div class="container">
            <article
              class:list={["stop-card", i % 2 === 0 ? "side-left" : "side-right"]}
              data-stop
            >
              <p class="stop-meta">
                <span class:list={["trail-icon", stop.icon]} role="img" aria-label={iconLabel[stop.icon]} />
                {stop.label}
              </p>
              {stop.entries.map((entry) => (
                <div class="entry">
                  <div class="entry-head">
                    <h2>{entry.title}</h2>
                    {entry.when && <span class="when">{entry.when}</span>}
                  </div>
                  {entry.role && <p class="role">{entry.role}</p>}
                  {entry.place && <p class="place">{entry.place}</p>}
                  {entry.bullets && (
                    <ul>
                      {entry.bullets.map((b) =>
                        typeof b === "string" ? (
                          <li>{b}</li>
                        ) : (
                          <li>
                            <strong>{b.text}</strong>
                            <ul>
                              {b.sub.map((s) => (
                                <li>{s}</li>
                              ))}
                            </ul>
                          </li>
                        ),
                      )}
                    </ul>
                  )}
                  {entry.lines && (
                    <dl>
                      {entry.lines.map(([k, v]) => (
                        <div>
                          <dt>{k}</dt>
                          <dd>{v}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </div>
              ))}
            </article>
          </div>
        </section>
      ))
    }

    <section class="run-end">
      <div class="container">
        <div class="intro" data-finish>
          <div class="end-links">
            <a class="text-link" href={`${base}resume.pdf`} target="_blank" rel="noopener">Resume PDF</a>
            <a class="text-link" href="https://www.linkedin.com/in/wdrav/" target="_blank" rel="noopener">LinkedIn</a>
            <a class="text-link" href={base}>Back home</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Will</p>
    </div>
  </footer>
</Layout>

<style>
  .run {
    position: relative;
  }

  .run .container {
    max-width: 1100px;
    position: relative;
    z-index: 1;
  }

  /* ----- Line art ----- */
  .trail-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .trail-route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 0.5 9;
    opacity: 0.45;
  }

  .trail-tracks {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .trail-art :global(.marker) {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.5;
    transition: fill 0.3s;
  }

  .trail-art :global(.marker.reached) {
    fill: var(--accent);
  }

  .trail-skier {
    fill: var(--text);
    filter: drop-shadow(0 0 6px var(--accent));
  }

  .ridge {
    display: block;
    width: 100%;
    max-width: 600px;
    height: 120px;
    margin: 0 auto 2.5rem;
    overflow: visible;
  }

  .ridge-line,
  .ridge-snow {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .ridge-line {
    stroke: var(--text-muted);
    stroke-width: 1.2;
    opacity: 0.6;
  }

  .ridge-snow {
    stroke: var(--text);
    stroke-width: 1.6;
    opacity: 0.85;
  }

  /* ----- Sections ----- */
  .run-intro {
    padding-top: 9rem;
    padding-bottom: 4rem;
  }

  .run-stop {
    padding: 3.5rem 0;
  }

  .run-end {
    padding: 6rem 0 8rem;
  }

  .intro {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    padding: 0.5rem 1rem;
  }

  .intro h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .intro .stop-meta {
    justify-content: center;
  }


  .text-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--line-bright);
    padding-bottom: 0.2rem;
  }

  .end-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  /* ----- Cards ----- */
  .stop-card {
    max-width: 480px;
    padding: 1.5rem 1.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--line-bright);
    border-radius: 4px;
  }

  .side-right {
    margin-left: auto;
  }

  .stop-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .entry + .entry {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .entry h2 {
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .role {
    margin-top: 0.25rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .place {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .entry ul {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: #c4c4d0;
    line-height: 1.55;
  }

  .entry li + li {
    margin-top: 0.4rem;
  }

  .entry li ul {
    margin-top: 0.4rem;
    color: var(--text-muted);
  }

  .entry strong {
    color: var(--text);
    font-weight: 600;
  }

  dl div + div {
    margin-top: 0.75rem;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  dd {
    font-size: 0.92rem;
    color: #c4c4d0;
  }

  /* ----- Trail-difficulty markers ----- */
  .trail-icon {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    flex: none;
  }
  .trail-icon.green {
    background: #3fb950;
    border-radius: 50%;
  }
  .trail-icon.blue {
    background: #3b82f6;
  }
  .trail-icon.black {
    width: 0.65rem;
    height: 0.65rem;
    background: #050507;
    border: 1px solid #e8e8ec;
    transform: rotate(45deg);
  }
  .trail-icon.double {
    width: 1.5rem;
    position: relative;
  }
  .trail-icon.double::before,
  .trail-icon.double::after {
    content: "";
    position: absolute;
    top: 0.08rem;
    width: 0.6rem;
    height: 0.6rem;
    background: #050507;
    border: 1px solid #e8e8ec;
    transform: rotate(45deg);
  }
  .trail-icon.double::before {
    left: 0.05rem;
  }
  .trail-icon.double::after {
    left: 0.8rem;
  }

  @media (max-width: 700px) {
    /* One column: the trail runs down the left edge beside the cards. */
    .stop-card,
    .side-right {
      margin-left: 1.75rem;
    }
    .stop-card {
      padding: 1.25rem 1.1rem;
    }
  }
</style>

<script>
  // Draws the trail to fit the cards: a dotted route winding from the top of
  // the run past each stop, solid "tracks" that fill in as you scroll, a marker
  // per stop, and line-art trees in the open space beside the trail.
  const SVG_NS = "http://www.w3.org/2000/svg";
  const run = document.querySelector<HTMLElement>("[data-run]")!;
  const svg = run.querySelector<SVGSVGElement>("[data-trail-art]")!;
  const route = svg.querySelector<SVGPathElement>("[data-route]")!;
  const tracks = svg.querySelector<SVGPathElement>("[data-tracks]")!;
  const markersG = svg.querySelector<SVGGElement>("[data-markers]")!;
  const treesG = svg.querySelector<SVGGElement>("[data-trees]")!;
  const skier = svg.querySelector<SVGCircleElement>("[data-skier]")!;
  const intro = run.querySelector<HTMLElement>(".run-intro .intro")!;
  const cards = Array.from(run.querySelectorAll<HTMLElement>("[data-stop]"));
  const finish = run.querySelector<HTMLElement>("[data-finish]")!;

  function mulberry32(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  type Pt = { x: number; y: number };
  let samples: { len: number; y: number }[] = [];
  let totalLen = 0;
  let markerYs: number[] = [];

  function el<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>) {
    const node = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    return node;
  }

  function build() {
    const box = run.getBoundingClientRect();
    const W = box.width;
    const H = run.scrollHeight;
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    const rel = (r: DOMRect) => ({
      left: r.left - box.left,
      right: r.right - box.left,
      top: r.top - box.top,
      bottom: r.bottom - box.top,
    });
    const narrow = W < 700;

    // Route points: just below the intro, one marker beside each card, then the finish.
    const introBox = rel(intro.getBoundingClientRect());
    const points: Pt[] = [{ x: (introBox.left + introBox.right) / 2, y: introBox.bottom + 18 }];
    markerYs = [];
    for (const card of cards) {
      const c = rel(card.getBoundingClientRect());
      let x: number;
      if (narrow) {
        x = c.left - 14;
      } else if (card.classList.contains("side-left")) {
        x = c.right + Math.min(90, (W - c.right) * 0.25);
      } else {
        x = c.left - Math.min(90, c.left * 0.25);
      }
      const y = c.top + 26;
      points.push({ x, y });
      markerYs.push(y);
    }
    const f = rel(finish.getBoundingClientRect());
    points.push({ x: (f.left + f.right) / 2, y: f.top - 10 });

    // Smooth S-curves between points (vertical tangents at each point).
    let d = `M${points[0].x},${points[0].y}`;
    for (let i = 1; i < points.length; i++) {
      const a = points[i - 1];
      const b = points[i];
      const k = (b.y - a.y) * 0.5;
      d += ` C${a.x},${a.y + k} ${b.x},${b.y - k} ${b.x},${b.y}`;
    }
    route.setAttribute("d", d);
    tracks.setAttribute("d", d);

    // Sample the path once so scrolling can map a height to a length quickly.
    totalLen = route.getTotalLength();
    samples = [];
    const n = 600;
    for (let i = 0; i <= n; i++) {
      const len = (totalLen * i) / n;
      samples.push({ len, y: route.getPointAtLength(len).y });
    }

    markersG.replaceChildren(
      ...points.slice(1, -1).map((p) => el("circle", { class: "marker", cx: p.x, cy: p.y, r: 6 })),
    );

    // Trees: small clusters in the open space beside each card, clear of the trail.
    const rand = mulberry32(1931);
    const trees: SVGElement[] = [];
    const trailXAt = (y: number) => {
      let lo = 0;
      let hi = samples.length - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (samples[mid].y < y) lo = mid + 1;
        else hi = mid;
      }
      return route.getPointAtLength(samples[lo].len).x;
    };
    if (!narrow) {
      for (const card of cards) {
        const c = rel(card.getBoundingClientRect());
        const left = card.classList.contains("side-left");
        const xMin = left ? c.right + 24 : 16;
        const xMax = left ? W - 16 : c.left - 24;
        const count = 4 + Math.floor(rand() * 4);
        for (let t = 0; t < count; t++) {
          const size = 20 + rand() * 22;
          const y = c.top + rand() * Math.max(40, c.bottom - c.top - size * 1.5);
          const x = xMin + rand() * Math.max(0, xMax - xMin - size);
          if (Math.abs(x + size / 2 - trailXAt(y + size)) < 40) continue;
          trees.push(el("use", { href: "#tree", x, y, width: size, height: size * 1.5 }));
        }
      }
    }
    treesG.replaceChildren(...trees);
    update();
  }

  // Tracks fill in down to a point a little below the middle of the screen.
  function update() {
    if (!samples.length) return;
    const headY = window.scrollY + window.innerHeight * 0.55 - (run.getBoundingClientRect().top + window.scrollY);
    let lo = 0;
    let hi = samples.length - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (samples[mid].y < headY) lo = mid + 1;
      else hi = mid;
    }
    const atBottom = window.scrollY >= document.documentElement.scrollHeight - window.innerHeight - 2;
    // At the very bottom of the page, finish the run even if the end is above the head.
    const len = atBottom ? totalLen : headY <= samples[0].y ? 0 : samples[lo].len;
    tracks.style.strokeDashoffset = String(1 - len / totalLen);
    const p = route.getPointAtLength(len);
    skier.setAttribute("cx", String(p.x));
    skier.setAttribute("cy", String(p.y));
    markersG.querySelectorAll(".marker").forEach((m, i) => m.classList.toggle("reached", markerYs[i] <= p.y + 1));
  }

  let queued = false;
  window.addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    },
    { passive: true },
  );
  let lastW = 0;
  window.addEventListener("resize", () => {
    // Height-only changes (mobile address bar) don't move the cards.
    if (window.innerWidth !== lastW) {
      lastW = window.innerWidth;
      build();
    } else update();
  });
  lastW = window.innerWidth;
  build();
  // Fonts change card heights; rebuild once they've loaded.
  document.fonts?.ready.then(build);
  window.addEventListener("load", build);
</script>
