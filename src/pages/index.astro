---
import Layout from "../layouts/Layout.astro";
import SkylineScene from "../components/SkylineScene.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const projects = [
  {
    label: "Startup · 2024–2025",
    title: "Measures AI",
    text: "Co-founded a Boulder startup that mined sales calls and emails for what drives deals. Built the NLP engine and React front end; raised $100K+.",
    tech: ["Python", "Hugging Face", "React"],
    links: [{ text: "measuresai.com", href: "https://measuresai.com" }],
  },
  {
    label: "Open Source · CU Boulder",
    title: "Excel2SBOL",
    text: "A Python library that converts Excel templates into SBOL, the data standard for synthetic biology, so researchers can share designs without writing code.",
    tech: ["Python", "SBOL", "PyPI"],
    links: [
      { text: "GitHub", href: "https://github.com/SynBioDex/Excel-to-SBOL" },
      { text: "PyPI", href: "https://pypi.org/project/excel2sbol/" },
    ],
  },
  {
    label: "macOS App · Swift",
    title: "Book Finder",
    text: "A macOS menu bar app that finds free, legal EPUBs from Project Gutenberg, Standard Ebooks, Wikisource and the Internet Archive.",
    tech: ["Swift", "SwiftUI"],
    links: [{ text: "Download .zip", href: `${base}BookFinder.zip`, download: true }],
  },
  {
    label: "Data Viz · Medium",
    title: "Property Value & Restaurants",
    text: "A visualization redesign clarifying how property values relate to restaurants, written up as a case study.",
    tech: ["Data Viz", "Design"],
    links: [
      {
        text: "Read the article",
        href: "https://medium.com/@wdrav/final-individual-redesign-clarifying-the-relationship-between-property-value-and-restaurant-0b7e32a9e60c",
      },
    ],
  },
];
---

<Layout title="Will — Developer & Data Analyst">
  <SkylineScene slot="background" />

  <!-- Navigation -->
  <nav>
    <div class="container">
      <a href={base} class="logo">will.</a>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href={`${base}experience/`}>Experience</a></li>
      </ul>
    </div>
  </nav>

  <!-- About / Hero -->
  <section class="hero" id="about">
    <div class="container">
      <div class="hero-content">
        <h1 class="reveal">
          Will
        </h1>
        <p class="bio reveal">
          Developer. Data Analyst. Always curious.
        </p>
        <div class="links reveal">
          <a href="https://www.linkedin.com/in/wdrav/" target="_blank" rel="noopener">LinkedIn</a>
          <button type="button" class="copy-email" data-user="will.dravenstott" data-domain="gmail.com" aria-live="polite">email</button>
          <a href={`${base}resume.pdf`} target="_blank" rel="noopener">resume</a>
        </div>
      </div>
    </div>
    <div class="scroll-indicator">
      <span>Scroll</span>
      <div class="arrow"></div>
    </div>
  </section>

  <!-- Scroll room for the background: New York breaks apart, Boulder rises
       (projects sit here), then Denver -->
  <div class="scene-scroll" data-scene-scroll>
    <section class="projects" id="projects">
      <div class="container">
        <div class="section-header">
          <h2>Projects</h2>
        </div>
        <div class="projects-grid">
          {projects.map((p) => (
            <article class="project-card reveal">
              <span class="project-label">{p.label}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <div class="tech">
                {p.tech.map((t) => <span>{t}</span>)}
              </div>
              <div class="project-links">
                {p.links.map((l) => (
                  <a href={l.href} {...(l.download ? { download: "" } : { target: "_blank", rel: "noopener" })}>
                    {l.text} →
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Footer -->
  <footer class="reveal">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Will</p>
    </div>
  </footer>
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  document.querySelectorAll(".section-header").forEach((el) => observer.observe(el));

  // Copy email to clipboard. The address is assembled at click time so it
  // isn't sitting in the HTML as plain text for scrapers.
  const emailButton = document.querySelector<HTMLButtonElement>(".copy-email");
  if (emailButton) {
    const label = emailButton.textContent;
    let resetTimer: number | undefined;

    const copyFallback = (text: string) => {
      const field = document.createElement("textarea");
      field.value = text;
      field.setAttribute("readonly", "");
      field.style.position = "fixed";
      field.style.opacity = "0";
      document.body.appendChild(field);
      field.select();
      const ok = document.execCommand("copy");
      field.remove();
      return ok;
    };

    emailButton.addEventListener("click", async () => {
      const email = `${emailButton.dataset.user}@${emailButton.dataset.domain}`;
      let copied = false;
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {
        copied = copyFallback(email);
      }
      // If copying failed, show the address so it can be copied by hand.
      emailButton.textContent = copied ? "Copied!" : email;
      emailButton.classList.toggle("copied", copied);
      window.clearTimeout(resetTimer);
      if (copied) {
        resetTimer = window.setTimeout(() => {
          emailButton.textContent = label;
          emailButton.classList.remove("copied");
        }, 2000);
      }
    });
  }
</script>
